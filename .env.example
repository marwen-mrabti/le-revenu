# Root env for docker-compose. Copy to .env. Never commit .env.
POSTGRES_USER=lerevenu
POSTGRES_PASSWORD=lerevenu
POSTGRES_DB=lerevenu
POSTGRES_PORT=5432
# `docker compose --profile apps up` needs none of the lines below: the compose file carries demo defaults
# for every secret. Set them here to override (same names as apps/cms/.env), for example before exposing the stack.
STRAPI_PORT=1337
WEB_PORT=3000
NEXT_PUBLIC_GOOGLE_LOGIN=false
# REVALIDATE_SECRET=   # shared by cms and web; one value overrides both
# APP_KEYS=  API_TOKEN_SALT=  ADMIN_JWT_SECRET=  TRANSFER_TOKEN_SALT=  JWT_SECRET=  ENCRYPTION_KEY=
