{
  "name": "lerevenu-community",
  "version": "0.1.0",
  "private": true,
  "description": "Communauté Le Revenu — Next.js 16 frontend + Strapi 5 backend (technical test)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:root",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "seed": "turbo run seed --filter=cms",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint:root": "eslint .",
    "verify": "sh scripts/verify-ci.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    }
  }
}
