{
  "kind": "collectionType",
  "collectionName": "discussions",
  "info": {
    "singularName": "discussion",
    "pluralName": "discussions",
    "displayName": "Discussion",
    "description": "A question or a free discussion started by a reader"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 10,
      "maxLength": 150
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "column": {
        "unique": true
      }
    },
    "content": {
      "type": "text",
      "required": true,
      "maxLength": 20000
    },
    "type": {
      "type": "enumeration",
      "enum": ["question", "discussion"],
      "default": "discussion",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "discussions",
      "required": true
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reply.reply",
      "mappedBy": "discussion"
    }
  }
}
