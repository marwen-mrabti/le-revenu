# Zero-setup mode: SQLite file database, demo keys. For local evaluation only, never for production.
HOST=0.0.0.0
PORT=1337
APP_KEYS="demo-local-sqlite-key-one-0123456789abcdef,demo-local-sqlite-key-two-0123456789abcdef"
API_TOKEN_SALT=demo-local-sqlite-api-token-salt-0123456789
ADMIN_JWT_SECRET=demo-local-sqlite-admin-jwt-secret-0123456789
TRANSFER_TOKEN_SALT=demo-local-sqlite-transfer-salt-0123456789
JWT_SECRET=demo-local-sqlite-jwt-secret-0123456789
ENCRYPTION_KEY=demo-local-sqlite-encryption-key-0123456789

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fr
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:1337
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=demo-local-sqlite-revalidate-secret-0123456789
SEED_DEMO_DATA=true
STRAPI_TELEMETRY_DISABLED=true

# ---- Third-party login (optional) ----
# Absolute public URL of this Strapi, used to build the OAuth redirect URI
PUBLIC_URL=http://localhost:1337
# Google OAuth client (Web application) with redirect URI <PUBLIC_URL>/api/connect/google/callback.
# Leave empty to keep Google login disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No mail server: mails are built and discarded
SMTP_HOST=
EMAIL_FROM="Communauté Le Revenu <no-reply@lerevenu.test>"
