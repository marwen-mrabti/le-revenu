{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "description": "Strapi 5 backend for Communaut\u00e9 Le Revenu",
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "dev": "strapi develop",
    "develop": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "lint": "eslint .",
    "type-check": "tsc --noEmit && tsc -p tests",
    "test:integration": "tsc -p tsconfig.json --outDir .tmp/test-dist && vitest run --config vitest.config.mts",
    "seed": "tsc -p tsconfig.json --outDir .tmp/seed-dist && node ./.tmp/seed-dist/scripts/seed.js",
    "generate:types": "strapi ts:generate-types",
    "dev:sqlite": "tsx scripts/sqlite-reset.ts && ENV_PATH=.env.sqlite strapi develop",
    "start:sqlite": "tsx scripts/sqlite-reset.ts && ENV_PATH=.env.sqlite strapi start"
  },
  "dependencies": {
    "@strapi/database": "5.59.0",
    "@strapi/plugin-users-permissions": "5.59.0",
    "@strapi/strapi": "5.59.0",
    "@strapi/utils": "5.59.0",
    "better-sqlite3": "^13.0.3",
    "pg": "8.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/koa": "2.15.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19.0 <=26.x.x"
  },
  "strapi": {
    "uuid": "8df3f8b2-4849-46c7-8c0d-0cf242469623",
    "installId": "4574ca91185b402d87df13d214717686ed5bab14ea44b3181bba9a812b0794bb"
  }
}
