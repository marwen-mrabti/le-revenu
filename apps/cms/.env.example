# ---- Server ----
HOST=0.0.0.0
PORT=1337
# Generate each secret with: openssl rand -base64 32
APP_KEYS="change-me-1,change-me-2"
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# ---- Database (PostgreSQL, see docker-compose.yml) ----
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lerevenu
DATABASE_USERNAME=lerevenu
DATABASE_PASSWORD=lerevenu
DATABASE_SSL=false
DATABASE_SCHEMA=public
# Used by `pnpm --filter cms test:integration` (schema is dropped on every run)
DATABASE_TEST_NAME=lerevenu_test

# ---- Users & Permissions ----
JWT_EXPIRES_IN=7d

# ---- Frontend integration ----
# Origins allowed by CORS (admin panel and tests; the Next.js app calls Strapi server-side)
CORS_ORIGINS=http://localhost:3000,http://localhost:1337
# Where the Next.js app lives, used to register the revalidation webhook
WEB_URL=http://localhost:3000
# Shared with apps/web REVALIDATE_SECRET
REVALIDATE_SECRET=change-me

# ---- Demo data ----
# Seeds categories, demo users and discussions on first boot when the database is empty
SEED_DEMO_DATA=true

# ---- Internationalization ----
# Default locale, honoured only on the very first boot (before any locale exists)
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fr

# ---- Third-party login (optional) ----
# Absolute public URL of this Strapi, used to build the OAuth redirect URI
PUBLIC_URL=http://localhost:1337
# Google OAuth client (Web application) with redirect URI <PUBLIC_URL>/api/connect/google/callback.
# Leave empty to keep Google login disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
