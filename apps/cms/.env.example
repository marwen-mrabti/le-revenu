# ---- Server ----
HOST=0.0.0.0
PORT=1337
# Generate each secret with: openssl rand -base64 32
APP_KEYS="change-me-1,change-me-2"
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# ---- Database (PostgreSQL, see docker-compose.yml) ----
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lerevenu
DATABASE_USERNAME=lerevenu
DATABASE_PASSWORD=lerevenu
DATABASE_SSL=false
DATABASE_SCHEMA=public
# Used by `pnpm --filter cms test:integration` (schema is dropped on every run)
DATABASE_TEST_NAME=lerevenu_test

# ---- Users & Permissions ----
JWT_EXPIRES_IN=7d

# ---- Frontend integration ----
# Origins allowed by CORS (admin panel and tests; the Next.js app calls Strapi server-side)
CORS_ORIGINS=http://localhost:3000,http://localhost:1337
# Where the Next.js app lives, used to register the revalidation webhook
WEB_URL=http://localhost:3000
# Where Strapi calls the web app's revalidate webhook when that differs from WEB_URL (Docker: http://web:3000).
# WEBHOOK_URL=
# Shared with apps/web REVALIDATE_SECRET
REVALIDATE_SECRET=change-me

# ---- Demo data ----
# Seeds categories, demo users and discussions on first boot when the database is empty
SEED_DEMO_DATA=true

# ---- Internationalization ----
# Default locale, honoured only on the very first boot (before any locale exists)
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fr

# ---- Third-party login (optional) ----
# Absolute public URL of this Strapi, used to build the OAuth redirect URI
PUBLIC_URL=http://localhost:1337
# true when a proxy terminates TLS in front of Strapi (Render, Railway, nginx): trusts X-Forwarded-Proto
TRUST_PROXY=false
# Google OAuth client (Web application) with redirect URI <PUBLIC_URL>/api/connect/google/callback.
# Leave empty to keep Google login disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Mail (password reset, email confirmation) ----
# Development: Mailpit from docker-compose (SMTP 1025, mailbox at http://localhost:8025).
# Real inboxes: Resend relay = smtp.resend.com, 465, SMTP_SECURE=true, SMTP_USER=resend, SMTP_PASS=<API key>,
# EMAIL_FROM=onboarding@resend.dev until a domain is verified (see README § 2).
# Leave SMTP_HOST empty to discard mails (zero-setup mode, sign-up then needs no confirmation).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Communauté Le Revenu <no-reply@lerevenu.test>"
EMAIL_REPLY_TO=no-reply@lerevenu.test
