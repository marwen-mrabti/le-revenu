# CI only: copied to .env by the test-cms job. Nothing here is a secret.
HOST=0.0.0.0
PORT=1337
APP_KEYS="ci-only-app-key-one-0123456789abcdef,ci-only-app-key-two-0123456789abcdef"
API_TOKEN_SALT=ci-only-api-token-salt-0123456789
ADMIN_JWT_SECRET=ci-only-admin-jwt-secret-0123456789
TRANSFER_TOKEN_SALT=ci-only-transfer-salt-0123456789
JWT_SECRET=ci-only-jwt-secret-0123456789
ENCRYPTION_KEY=ci-only-encryption-key-0123456789

DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lerevenu_test
DATABASE_TEST_NAME=lerevenu_test
DATABASE_USERNAME=lerevenu
DATABASE_PASSWORD=lerevenu
DATABASE_SSL=false
DATABASE_SCHEMA=public

JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:1337
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=ci-only-revalidate-secret-0123456789
SEED_DEMO_DATA=true
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=fr
STRAPI_TELEMETRY_DISABLED=true

# ---- Third-party login (optional) ----
# Absolute public URL of this Strapi, used to build the OAuth redirect URI
PUBLIC_URL=http://localhost:1337
# Google OAuth client (Web application) with redirect URI <PUBLIC_URL>/api/connect/google/callback.
# Leave empty to keep Google login disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No mail server: mails are built and discarded
SMTP_HOST=
EMAIL_FROM="Communauté Le Revenu <no-reply@lerevenu.test>"
