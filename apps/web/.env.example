# Optional in development (defaults in src/config/env.ts match apps/cms/.env.sqlite); required in production.
# Copy to .env to override. Server-only values: never prefix with NEXT_PUBLIC_.
STRAPI_URL=http://localhost:1337
AUTH_COOKIE_NAME=lr_session
# Shared with apps/cms REVALIDATE_SECRET. Generate: openssl rand -base64 32
REVALIDATE_SECRET=change-me

# Public (baked into the client bundle at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows "Continuer avec Google" on the login and sign-up pages (needs GOOGLE_* set on the cms side)
NEXT_PUBLIC_GOOGLE_LOGIN=false
# Only used by the browser to finish the Google flow (Strapi keeps the provider token in its own session)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
